{
  "name": "supervision_inteligente",
  "version": "1.0.0",
  "description": "Backend REST NestJS para supervisión de visitas en centros de costo",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run prisma:generate && tsc -b",
    "start": "node dist/main",
    "start:dev": "npm run build && node dist/main",
    "start:debug": "node --inspect dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "echo \"No linter configured. Use tsc for type-checking.\""
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "keywords": [
    "nestjs",
    "prisma",
    "fcm",
    "jwt",
    "hackathon"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.5",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^12.2.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@prisma/engines": "^5.22.0",
    "@swc/jest": "^0.2.39",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.3",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.1.6",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
